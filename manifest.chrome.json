{
  "manifest_version": 3,
  "name": "OpenViet IME",
  "version": "1.1.2",
  "description": "Modern Cross-Browser Vietnamese Input Extension with Telex, VNI, Modern Tone Placement, and Text Expansion Macro Engine.",
  "author": "OpenViet Team",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "OpenViet IME - Bộ Gõ Tiếng Việt",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "32": "src/assets/icon32.png",
      "48": "src/assets/icon48.png",
      "64": "src/assets/icon64.png",
      "128": "src/assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "commands": {
    "toggle-ime": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Bật/Tắt bộ gõ Tiếng Việt"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "32": "src/assets/icon32.png",
    "48": "src/assets/icon48.png",
    "64": "src/assets/icon64.png",
    "128": "src/assets/icon128.png"
  }
}

